# Virtual environment
venv/

# Python bytecode cache
__pycache__/
*.pyc
.ipynb_checkpoints/

# Model checkpoints / pretrained weights
*.pth
*.pt
pretrained_ckpt/

# Bulk processed image datasets (small CSV split metadata in data/isic2017/ is kept)
data/isic2017/Image/
data/isic2017/Image_clahe/
data/isic2017/Image_clahe_aug/
data/isic2017/Image_dullrazor/
data/isic2017/Image_hsv/
data/isic2017/Image_ycbcr/
data/isic2017/Label/
data/isic2017/Label_aug/

# Raw ISIC 2017 data download
isic2017_raw/

# Training run outputs: per-fold checkpoints + per-epoch logs (tens of GB)
results/
kfold_logs/

# Generated visualization/analysis dumps (not source)
per_image_analysis/
per_image_analysis_official/

# per_image_analysis_v2/ is excluded recursively EXCEPT the 4 small EGE-UNet
# hard-image CSVs below (source-of-truth image ID lists + augmentation
# manifest for EGE-UNet's own hard-image pilot, kept for reproducibility).
# gitignore requires negating each ancestor directory level with a trailing
# /* (not a bare trailing /) for the file-level negations to take effect.
per_image_analysis_v2/*
!per_image_analysis_v2/bad_image_augmentation/
per_image_analysis_v2/bad_image_augmentation/*
!per_image_analysis_v2/bad_image_augmentation/bad_images_egeunet_seed42_dice94.csv
!per_image_analysis_v2/bad_image_augmentation/bad_images_egeunet_seed42_test58.csv
!per_image_analysis_v2/bad_image_augmentation/manifest_egeunet_seed42_dice94_shift5.csv
!per_image_analysis_v2/bad_image_augmentation/shift_skip_report_egeunet94.csv

# External cloned dependency (not authored here, has its own git history)
dullrazor_repo/

# Backed-up original AViT git history (not an active repo, just kept on disk)
AViT/.git-siyiwind-backup/

# Misc local logs, pid files, scratch build output
*.log
*.pid
isic2017_key_code.zip
review.html

# OS/editor cruft
.DS_Store
Thumbs.db

# Claude Code local session/config
.claude/
